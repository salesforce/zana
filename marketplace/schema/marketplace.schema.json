{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/salesforce/zana/marketplace/schema/marketplace.schema.json",
  "title": "Zana plugin marketplace manifest",
  "description": "Pointer-only catalog of plugin listings. Refresh never executes plugin code; install resolves each entry's git or npm source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "displayName", "plugins"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "description", "author", "source"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "overview": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "icon": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lucide": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "tags": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "github": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "npm": {
              "type": "object",
              "additionalProperties": false,
              "required": ["package", "range"],
              "properties": {
                "package": { "type": "string", "minLength": 1 },
                "range": { "type": "string", "minLength": 1 }
              }
            },
            "git": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url"],
              "properties": {
                "url": { "type": "string", "minLength": 1 },
                "subdir": { "type": "string", "minLength": 1 },
                "range": { "type": "string", "minLength": 1 },
                "ref": { "type": "string", "minLength": 1 },
                "tagPrefix": { "type": "string", "maxLength": 128 }
              }
            }
          },
          "anyOf": [{ "required": ["npm"] }, { "required": ["git"] }]
        }
      }
    }
  }
}
