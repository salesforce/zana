{
  "name": "zcc-plugin-platform-hooks-probe",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "zcc": ">=1.0.0",
    "zccPluginSdk": ">=0.1.0"
  },
  "zcc": {
    "name": "Platform Hooks Probe",
    "description": "Disposable test-only fixture exercising every Zana plugin platform hook (host RPC, interactions, dispatch policy, tool policy, capabilities, lifecycle, contributions, availability).",
    "branding": {
      "icon": "FlaskConical"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": ["skills"],
    "projectTab": {
      "label": "Hooks Probe",
      "global": false
    },
    "mcpServers": {
      "platform-hooks-probe": {
        "type": "stdio",
        "command": "node",
        "args": ["./mcp-server.js"],
        "alwaysOn": false
      }
    },
    "extra": {
      "notes": "Test-only fixture. Never ship to the marketplace or under plugins/."
    }
  },
  "devDependencies": {
    "@zana-ai/zcc-plugin-sdk": "0.1.0",
    "@types/react": "^19.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "vitest": "^4.1.10",
    "zod": "^4.3.6"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
