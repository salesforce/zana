#!/bin/sh
# Change-aware verification for pushes. GitHub CI remains merge authority; this
# hook gives local feedback without trusting a dirty worktree.
set -eu

if ! command -v node >/dev/null 2>&1; then
  printf '%s\n' 'pre-push: node is required; aborting push.' >&2
  exit 1
fi

# Forward Git's tuple stream unchanged. The selector reads it once and applies
# the strictest policy when one push updates multiple refs.
exec node scripts/pre-push-verification.mjs "$@"
