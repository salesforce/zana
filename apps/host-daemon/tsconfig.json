{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "customConditions": ["source"],
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/daemon.ts",
    "src/local-pty-host.ts",
    "src/terminal-manager.ts",
    "src/utility-entry.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
