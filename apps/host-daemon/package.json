    "@zana-ai/zcc-contracts": "workspace:*",
    "@zana-ai/zcc-domain": "workspace:*",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
