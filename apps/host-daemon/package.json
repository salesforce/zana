{
  "name": "@zana-ai/zcc-host-daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZCC local execution host for authorized PTY and harness work.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "default": "./src/index.ts"
