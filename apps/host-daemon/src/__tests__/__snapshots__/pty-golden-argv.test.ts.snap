  "command": "<SCHEDULED_SUPERVISOR>",
  "sessionEnv": {
    "ZCC_HOOK_URL": "http://127.0.0.1:<PORT>/hook/stop/proj1/<UUID>",
    "ZCC_MCP_URL": "http://127.0.0.1:39999/mcp/proj1/<UUID>/<SESSION_CREDENTIAL>",
