    "{"hooks":{"Stop":[{"matcher":"","hooks":[{"type":"command","command":"ZCC_IN=$(cat); case \\"$ZCC_IN\\" in *'\\"stop_hook_active\\":true'*) exit 0;; esac; if [ -n \\"$ZCC_HOOK_URL\\" ]; then curl -s -m 5 -X POST \\"$ZCC_HOOK_URL\\" >/dev/null 2>&1 || true; fi; exit 0"},{"type":"command","command":"cat >/dev/null 2>&1; [ -n \\"$ZCC_TOOLACTIVITY_URL\\" ] && curl -s -m 5 -X POST \\"$ZCC_TOOLACTIVITY_URL/clear\\" >/dev/null 2>&1 || true; exit 0"}]}],"Notification":[{"matcher":"","hooks":[{"type":"command","command":"ZCC_IN=$(cat); case \\"$ZCC_IN\\" in *'\\"permission_prompt\\"'*|*'\\"elicitation_dialog\\"'*) [ -n \\"$ZCC_NOTIFY_URL\\" ] && curl -s -m 5 -X POST \\"$ZCC_NOTIFY_URL/blocked\\" >/dev/null 2>&1 || true;; esac; exit 0"}]}],"PreToolUse":[{"matcher":"AskUserQuestion","hooks":[{"type":"command","command":"cat >/dev/null 2>&1; [ -n \\"$ZCC_NOTIFY_URL\\" ] && curl -s -m 5 -X POST \\"$ZCC_NOTIFY_URL/blocked\\" >/dev/null 2>&1 || true; exit 0"}]},{"matcher":"Task","hooks":[{"type":"command","command":"ZCC_IN=$(cat); [ -n \\"$ZCC_SUBAGENT_URL\\" ] && printf \\"%s\\" \\"$ZCC_IN\\" | curl -s -m 5 -X POST --data-binary @- \\"$ZCC_SUBAGENT_URL/start\\" >/dev/null 2>&1 || true; exit 0"}]},{"matcher":"","hooks":[{"type":"command","command":"cat >/dev/null 2>&1; [ -n \\"$ZCC_TOOLACTIVITY_URL\\" ] && curl -s -m 5 -X POST \\"$ZCC_TOOLACTIVITY_URL/start\\" >/dev/null 2>&1 || true; exit 0"}]}],"PostToolUse":[{"matcher":"AskUserQuestion","hooks":[{"type":"command","command":"cat >/dev/null 2>&1; [ -n \\"$ZCC_NOTIFY_URL\\" ] && curl -s -m 5 -X POST \\"$ZCC_NOTIFY_URL/unblocked\\" >/dev/null 2>&1 || true; exit 0"}]},{"matcher":"","hooks":[{"type":"command","command":"cat >/dev/null 2>&1; [ -n \\"$ZCC_TOOLACTIVITY_URL\\" ] && curl -s -m 5 -X POST \\"$ZCC_TOOLACTIVITY_URL/stop\\" >/dev/null 2>&1 || true; exit 0"}]}],"UserPromptSubmit":[{"matcher":"","hooks":[{"type":"command","command":"cat >/dev/null 2>&1; [ -n \\"$ZCC_NOTIFY_URL\\" ] && curl -s -m 5 -X POST \\"$ZCC_NOTIFY_URL/unblocked\\" >/dev/null 2>&1 || true; exit 0"}]}],"SubagentStop":[{"matcher":"","hooks":[{"type":"command","command":"cat >/dev/null 2>&1; [ -n \\"$ZCC_SUBAGENT_URL\\" ] && curl -s -m 5 -X POST \\"$ZCC_SUBAGENT_URL/stop\\" >/dev/null 2>&1 || true; exit 0"}]}]}}",
    "--allowedTools",
    "mcp__zcc-inbox__inbox_push,mcp__zcc-inbox__inbox_ask,mcp__zcc-inbox__inbox_search,mcp__zcc-inbox__schedule_list,mcp__zcc-inbox__preview_file,mcp__zcc-inbox__schedule_report,mcp__zcc-inbox__register_agent,mcp__zcc-inbox__list_agents,mcp__zcc-inbox__find_agent,mcp__zcc-inbox__agent_inbox,mcp__zcc-inbox__followup_create,mcp__zcc-inbox__followup_list,mcp__zcc-inbox__followup_resolve,mcp__zcc-inbox__library_write,mcp__zcc-inbox__library_read,mcp__zcc-inbox__library_list,mcp__zcc-inbox__goal_create,mcp__zcc-inbox__goal_list,mcp__zcc-inbox__register_project",
