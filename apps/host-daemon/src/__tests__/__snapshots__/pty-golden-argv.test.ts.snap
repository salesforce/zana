 --data-binary @- \\"$ZCC_CONTENTSCREEN_URL\\" 2>/dev/null || true; fi; exit 0"}]}],"UserPromptSubmit":[{"matcher":"","hooks":[{"type":"command","command":"cat >/dev/null 2>&1; [ -n \\"$ZCC_NOTIFY_URL\\" ] && curl -s -m 5 -X POST \\"$ZCC_NOTIFY_URL/unblocked\\" >/dev/null 2>&1 || true; exit 0"}]}],"SubagentStop":[{"matcher":"","hooks":[{"type":"command","command":"cat >/dev/null 2>&1; [ -n \\"$ZCC_SUBAGENT_URL\\" ] && curl -s -m 5 -X POST \\"$ZCC_SUBAGENT_URL/stop\\" >/dev/null 2>&1 || true; exit 0"}]}]}}",
