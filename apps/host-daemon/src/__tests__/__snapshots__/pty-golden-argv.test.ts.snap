/unblocked\\" >/dev/null 2>&1 || true; exit 0"}]}],"SubagentStop":[{"matcher":"","hooks":[{"type":"command","command":"cat >/dev/null 2>&1; [ -n \\"$ZCC_SUBAGENT_URL\\" ] && curl -s -m 5 -X POST \\"$ZCC_SUBAGENT_URL/stop\\" >/dev/null 2>&1 || true; exit 0"}]}]}}",
    "--allowedTools",
    "mcp__zcc-inbox__inbox_push,mcp__zcc-inbox__inbox_ask,mcp__zcc-inbox__inbox_search,mcp__zcc-inbox__schedule_list,mcp__zcc-inbox__preview_file,mcp__zcc-inbox__schedule_report,mcp__zcc-inbox__register_agent,mcp__zcc-inbox__list_agents,mcp__zcc-inbox__find_agent,mcp__zcc-inbox__agent_inbox,mcp__zcc-inbox__followup_create,mcp__zcc-inbox__followup_list,mcp__zcc-inbox__followup_resolve,mcp__zcc-inbox__library_write,mcp__zcc-inbox__library_read,mcp__zcc-inbox__library_list,mcp__zcc-inbox__goal_create,mcp__zcc-inbox__goal_list,mcp__zcc-inbox__register_project",
