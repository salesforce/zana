{
  "expo": {
    "name": "Zana",
    "slug": "zana-mobile",
    "version": "2.4.0",
    "scheme": "zana",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ai.zana.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "buildNumber": "202609281455"
    },
    "android": {
      "package": "ai.zana.mobile",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-notifications",
      "expo-quick-actions"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "platforms": [
      "ios",
      "android"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b4e4124-5a4b-41a0-acf9-25ca4bab8fca"
      }
    },
    "owner": "grebmann"
  }
}
