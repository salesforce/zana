{
  "name": "@zana-ai/zcc-plugin-sdk",
  "version": "0.1.0",
  "description": "SDK contract for Zana Command Center plugins — ZccPluginApi, definePluginApp, and the package.json zcc manifest.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/salesforce/zana"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./bundled-types/zcc-plugin-sdk.d.ts",
    "exports": {
      ".": {
        "types": "./bundled-types/zcc-plugin-sdk.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./app": {
        "types": "./bundled-types/zcc-plugin-sdk-app.d.ts",
        "import": "./dist/app.js",
        "default": "./dist/app.js"
      },
      "./server": {
        "types": "./bundled-types/zcc-plugin-sdk-server.d.ts",
        "import": "./dist/server.js",
        "default": "./dist/server.js"
      },
      "./testing": {
        "types": "./bundled-types/zcc-plugin-sdk-testing.d.ts",
        "import": "./dist/testing/index.js",
        "default": "./dist/testing/index.js"
      },
      "./testing/app": {
        "types": "./bundled-types/zcc-plugin-sdk-testing-app.d.ts",
        "import": "./dist/testing/app.js",
        "default": "./dist/testing/app.js"
      },
      "./provider-bridge": {
        "types": "./src/provider-bridge.ts",
        "import": "./dist/provider-bridge.js",
        "default": "./dist/provider-bridge.js"
      },
      "./provider-bridge/testing": {
        "types": "./src/provider-bridge-testing.ts",
        "import": "./dist/provider-bridge-testing.js",
        "default": "./dist/provider-bridge-testing.js"
      }
    }
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "files": ["dist", "bundled-types", "README.md"],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./app": {
      "source": "./src/app.ts",
      "types": "./src/app.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    },
    "./server": {
      "source": "./src/server.ts",
      "types": "./src/server.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./src/testing/index.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./testing/app": {
      "source": "./src/testing/app.ts",
      "types": "./src/testing/app.ts",
      "import": "./dist/testing/app.js",
      "default": "./dist/testing/app.js"
    },
    "./provider-bridge": {
      "source": "./src/provider-bridge.ts",
      "types": "./src/provider-bridge.ts",
      "import": "./dist/provider-bridge.js",
      "default": "./dist/provider-bridge.js"
    },
    "./provider-bridge/testing": {
      "source": "./src/provider-bridge-testing.ts",
      "types": "./src/provider-bridge-testing.ts",
      "import": "./dist/provider-bridge-testing.js",
      "default": "./dist/provider-bridge-testing.js"
    }
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "prepack": "node scripts/build-runtime.mjs",
    "test": "vitest run --config ../../vitest.config.ts src/testing/index.test.ts src/app.test.ts src/provider-bridge.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "dependencies": {
    "@zana-ai/zcc-agent-process-utils": "workspace:*",
    "@zana-ai/zcc-domain": "workspace:*",
    "@zana-ai/zcc-host-daemon-contract": "workspace:*",
    "@zana-ai/zcc-provider-bridge-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
