{
  "name": "@zana-ai/zcc-agent-runtime",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./shared/json-rpc-envelope": {
      "source": "./src/shared/json-rpc-envelope.ts",
      "types": "./src/shared/json-rpc-envelope.ts",
      "default": "./src/shared/json-rpc-envelope.ts"
    },
    "./test": {
      "source": "./src/test/index.ts",
      "types": "./src/test/index.ts",
      "default": "./src/test/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts --exclude '**/integration/**'",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.197",
    "@anthropic-ai/sdk": "^0.93.0",
    "@zana-ai/zcc-domain": "workspace:*",
    "@zana-ai/zcc-host-daemon-contract": "workspace:*",
    "@zana-ai/zcc-agent-process-utils": "workspace:*",
    "@zana-ai/zcc-provider-bridge-protocol": "workspace:*",
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@zana-ai/zcc-tsconfig": "workspace:*",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "private": true
}
