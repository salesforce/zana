{
  "name": "zana-command-center-website",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing, marketplace, docs, and download site for Zana Command Center",
  "scripts": {
    "sync-docs": "node scripts/sync-docs.mjs",
    "predev": "node scripts/sync-docs.mjs",
    "dev": "next dev -p 4321",
    "prebuild": "node scripts/sync-docs.mjs",
    "build": "next build",
    "start": "next start -p 4321",
    "lint": "next lint",
    "db:generate": "npm run db:generate:sqlite && npm run db:generate:pg",
    "db:generate:sqlite": "drizzle-kit generate",
    "db:generate:pg": "DRIZZLE_DIALECT=pg drizzle-kit generate",
    "db:migrate": "node -e \"const p='./lib/db/migrate.mjs'; import(p).catch(e=>{ if(e.code==='ERR_MODULE_NOT_FOUND'){console.log('db:migrate: lib/db/migrate.mjs not present yet (Phase 1) — skipping.'); process.exit(0);} throw e; })\"",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "marked": "^18.0.10",
    "nanoid": "^6.0.1",
    "next": "^16.3.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "shiki": "^4.4.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
