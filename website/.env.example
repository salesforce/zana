# Public plugin marketplace / registry index. Served at
# /marketplace/v1/marketplace.json from this site. The desktop app seeds it when
# ZCC_OFFICIAL_MARKETPLACE_URL points at the HTTPS origin + that path.
# NEXT_PUBLIC_REGISTRY_URL is the same-origin (or CDN) index.json the desktop
# app can also read. When unset, the marketplace page still lists official
# plugins from /marketplace/v1/marketplace.json.
NEXT_PUBLIC_REGISTRY_URL=

# electron-updater generic feed base (where latest-mac.yml + artifacts live).
# The download page parses latest-mac.yml from here for the live version.
# NEXT_PUBLIC_* values are inlined at Docker/Next *build* time — pass them as
# build args (see Dockerfile / heroku.yml), not only runtime env.
NEXT_PUBLIC_UPDATE_FEED_URL=

# Fallback version shown when the update feed is unreachable.
NEXT_PUBLIC_APP_VERSION=2.0.3

# ---- Publish backend (see ../docs/extension-marketplace-registry-design.md §4) ----

# GitHub OAuth app credentials for the publisher web login
# (app/api/auth/github/{login,callback}).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth callback URL registered with the GitHub OAuth app.
GITHUB_OAUTH_CALLBACK=http://localhost:4321/api/auth/github/callback

# HMAC key used to sign the session cookie value (random, keep secret).
SESSION_SECRET=

# Data layer connection string. Unset or "file:./dev.db" → SQLite
# (better-sqlite3, local/dev/CI). "postgres://…" → Postgres (pg, prod).
DATABASE_URL=

# Ed25519 signing keypair for release archives (server signs, app pins the
# public half). REGISTRY_SIGNING_KEY is a PRIVATE key (pkcs8 PEM) — never
# commit a real value. REGISTRY_PUBLIC_KEY is the matching spki PEM, published
# so the desktop app can pin it in ~/.zcc/extension-registry.json.
REGISTRY_SIGNING_KEY=
REGISTRY_PUBLIC_KEY=

# Base URL this deployment is served from; used to build release.url values in
# the served index.json, canonical URLs, and the marketplace
# `zcc marketplace add` snippet. Must be https:// in production (the app rejects
# non-HTTPS release URLs). Change this to retarget the public origin without a
# code change (e.g. https://zcc-7808c5bc8f3d.herokuapp.com).
PUBLIC_BASE_URL=http://localhost:4321

# "mock" in tests/dev → inject fake GitHub OAuth responses (website/lib/github.ts)
# instead of calling github.com. Unset/anything else → real GitHub calls.
GITHUB_OAUTH_MODE=

# Network gate (see middleware.ts, ported from the old server.mjs). Comma or
# space separated IPv4 CIDRs allowed to reach the site (e.g. "10.0.0.0/8,
# 100.64.0.0/10"). Unset/empty = fail OPEN (no gating). Once set, fails CLOSED
# for anything outside the ranges. /api/healthz is always reachable.
# Pairing (`/install.sh`, enroll, host ws) and `/_zcc/relay` are handled by
# the front door BEFORE Next, so ALLOWED_CIDRS does not block remotes.
ALLOWED_CIDRS=

# Shared secret for the laptop pairing tunnel. Must match the token baked into
# official desktop builds (electron-vite `ZCC_RELAY_TOKEN`) and Heroku config.
# Never commit a real value; set it with `heroku config:set ZCC_RELAY_TOKEN=... -a zcc`.
ZCC_RELAY_TOKEN=
