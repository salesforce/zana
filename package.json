{
  "name": "zana-command-center",
  "productName": "Zana",
  "version": "2.0.5",
  "private": true,
  "description": "Zana Command Center — multi-project terminal hub for Claude Code sessions",
  "author": "grebmann",
  "homepage": "https://github.com/salesforce/zana",
  "main": "out/main/index.js",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "prepare": "node scripts/ensure-node-pty-helper.mjs && node scripts/ensure-better-sqlite3.mjs && git config core.hooksPath .githooks || true",
    "build:cli": "pnpm --filter @zcc/cli build",
    "fetch:opencode": "node scripts/fetch-opencode-binaries.mjs",
    "predev": "node scripts/ensure-node-pty-helper.mjs && node scripts/ensure-better-sqlite3.mjs && pnpm run build:cli && node scripts/seed-extensions.mjs",
    "predev:legacy": "pnpm run predev",
    "dev:legacy": "electron-vite dev",
    "dev": "node scripts/dev-local.mjs",
    "dev:prod": "node scripts/dev-local.mjs --packaged",
    "dev:web": "ZCC_SKIP_DESKTOP=1 node scripts/dev-local.mjs",
    "dev:desktop": "pnpm run predev && pnpm --filter @zana-ai/zcc-desktop dev",
    "prestart": "node scripts/ensure-node-pty-helper.mjs && node scripts/ensure-better-sqlite3.mjs && pnpm run build:cli && node scripts/seed-extensions.mjs",
    "prestart:legacy": "pnpm run prestart",
    "start:legacy": "electron-vite dev",
    "start": "node scripts/dev-local.mjs",
    "start:prod": "node scripts/dev-local.mjs --packaged",
    "start:desktop": "pnpm --filter @zana-ai/zcc-desktop start",
    "seed:extensions": "node scripts/seed-extensions.mjs",
    "publish-extension": "node scripts/publish-extension.mjs",
    "prebuild": "node scripts/ensure-node-pty-helper.mjs && node scripts/ensure-better-sqlite3.mjs && node scripts/build-scheduled-supervisor.mjs && pnpm run build:cli && node scripts/seed-extensions.mjs",
    "prebuild:legacy": "pnpm run prebuild",
    "build:legacy": "electron-vite build",
    "build": "electron-vite build",
    "build:all": "turbo run build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build:legacy && playwright test",
    "test:e2e:docker": "bash scripts/e2e-docker.sh",
    "test:docker:pairing": "ZCC_DOCKER_E2E=1 vitest run docker/remote-machine/pairing-session.e2e.test.ts",
    "docker:host-daemon": "bash scripts/docker-remote-machine.sh --join",
    "docker:remote-machine": "bash scripts/docker-remote-machine.sh",
    "docker:remote-machine:down": "bash scripts/docker-remote-machine.sh down",
    "test:e2e:only": "playwright test",
    "test:e2e:thread": "playwright test -c playwright.thread-web.config.ts",
    "test:e2e:headed": "pnpm run build:legacy && playwright test --headed",
    "test:smoke": "pnpm run build:legacy && playwright test e2e/smoke.spec.ts",
    "test:smoke:only": "playwright test e2e/smoke.spec.ts",
    "test:codex:live": "ZCC_LIVE_CODEX=1 vitest run apps/host-daemon/src/harness/__tests__/codex-provider.live.test.ts",
    "rebuild": "electron-rebuild -f -w node-pty && node scripts/ensure-better-sqlite3.mjs",
    "rebuild:electron": "electron-rebuild -f -w node-pty -w better-sqlite3",
    "check:release-notes": "node scripts/check-release-notes.mjs",
    "dist": "pnpm --filter @zana-ai/zcc-desktop package",
    "dist:mac": "pnpm --filter @zana-ai/zcc-desktop package:mac",
    "release:mac": "pnpm --filter @zana-ai/zcc-desktop release:mac",
    "release:static": "pnpm run dist:mac && node scripts/upload-release.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-ai": "^0.80.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "croner": "^10.0.1",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.35.0",
    "mermaid": "^11.16.1",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-diff-viewer-continued": "^4.3.0",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.7.0",
    "ws": "^8.21.3",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "optionalDependencies": {
    "microsandbox": "0.6.10"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "happy-dom": "^20.10.6",
    "js-yaml": "^4.1.0",
    "tsx": "^4.20.5",
    "turbo": "^2.8.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/salesforce/zana"
  },
  "keywords": [],
  "license": "MIT"
}
