{
  "name": "zana-command-center",
  "productName": "Zana",
  "version": "2.2.2",
  "private": true,
  "description": "Zana Command Center — multi-project terminal hub for Claude Code sessions",
  "author": "grebmann",
  "homepage": "https://github.com/salesforce/zana",
  "main": "out/main/index.js",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "prepare": "node scripts/ensure-node-pty-helper.mjs && node scripts/ensure-better-sqlite3.mjs && git config core.hooksPath .githooks || true",
    "build:cli": "pnpm --filter @zcc/cli build",
    "fetch:opencode": "node scripts/fetch-opencode-binaries.mjs",
    "predev": "node scripts/prepare-dev.mjs",
    "dev": "node scripts/dev-local.mjs",
    "dev:prod": "node scripts/dev-local.mjs --packaged",
    "dev:web": "ZCC_SKIP_DESKTOP=1 node scripts/dev-local.mjs",
    "start": "node scripts/start-packaged.mjs",
    "seed:extensions": "node scripts/seed-extensions.mjs",
    "publish-extension": "node scripts/publish-extension.mjs",
    "build": "node scripts/build-electron.mjs",
    "build:all": "turbo run build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-electron-e2e.mjs --build",
    "test:e2e:docker": "bash scripts/e2e-docker.sh",
    "test:docker:pairing": "ZCC_DOCKER_E2E=1 vitest run docker/remote-machine/pairing-session.e2e.test.ts",
    "test:docker:live": "bash scripts/docker-machine-live-scenarios.sh",
    "docker:host-daemon": "bash scripts/docker-remote-machine.sh --join",
    "docker:remote-machine": "bash scripts/docker-remote-machine.sh",
    "docker:remote-machine:down": "bash scripts/docker-remote-machine.sh down",
    "test:e2e:only": "node scripts/run-electron-e2e.mjs",
    "test:e2e:thread": "playwright test -c playwright.thread-web.config.ts",
    "test:e2e:headed": "node scripts/run-electron-e2e.mjs --build --headed",
    "test:smoke": "node scripts/run-electron-e2e.mjs --build e2e/smoke.spec.ts",
    "test:smoke:only": "node scripts/run-electron-e2e.mjs e2e/smoke.spec.ts",
    "test:e2e:jobteam": "node scripts/run-jobteam-e2e.mjs",
    "test:e2e:jobteam:only": "playwright test e2e/job-team-launch-ui.spec.ts e2e/job-team-failed-dag.spec.ts e2e/cli-agent-job-team-run.spec.ts e2e/modern-owner-job-team-run.spec.ts",
    "test:codex:live": "ZCC_LIVE_CODEX=1 vitest run apps/host-daemon/src/harness/__tests__/codex-provider.live.test.ts",
    "live:smoke": "pnpm --filter @zana-ai/zcc-control live:smoke",
    "live:matrix": "pnpm --filter @zana-ai/zcc-control live:matrix",
    "live:cli-scenarios": "pnpm --filter @zana-ai/zcc-control live:cli-scenarios",
    "live:mode-reasoning": "pnpm --filter @zana-ai/zcc-control live:mode-reasoning",
    "live:browser": "pnpm --filter @zana-ai/zcc-control live:browser",
    "live:memory": "pnpm --filter @zana-ai/zcc-control live:memory",
    "rebuild": "node scripts/ensure-node-pty-helper.mjs --electron && node scripts/ensure-better-sqlite3.mjs",
    "rebuild:electron": "node scripts/ensure-node-pty-helper.mjs --electron && node scripts/ensure-better-sqlite3.mjs --electron",
    "check:release-notes": "node scripts/check-release-notes.mjs",
    "clean:dist": "node scripts/clean-dist.mjs",
    "dist": "pnpm --filter @zana-ai/zcc-desktop package",
    "dist:mac": "pnpm --filter @zana-ai/zcc-desktop package:mac",
    "release:mac": "pnpm --filter @zana-ai/zcc-desktop release:mac",
    "release:static": "pnpm run dist:mac && node scripts/upload-release.mjs",
    "build:prepare": "node scripts/ensure-node-pty-helper.mjs && node scripts/ensure-better-sqlite3.mjs && node scripts/ensure-better-sqlite3.mjs --electron && node scripts/build-scheduled-supervisor.mjs && pnpm run build:cli && node scripts/seed-extensions.mjs",
    "dev:prepare": "node scripts/ensure-node-pty-helper.mjs && node scripts/ensure-better-sqlite3.mjs && node scripts/ensure-better-sqlite3.mjs --electron && pnpm run build:cli && node scripts/seed-extensions.mjs",
    "mobile:dev": "pnpm --filter @zana-ai/zcc-mobile dev",
    "mobile:ios": "pnpm --filter @zana-ai/zcc-mobile ios",
    "mobile:android": "pnpm --filter @zana-ai/zcc-mobile android",
    "mobile:serve": "node --import tsx scripts/mobile-serve.ts",
    "mobile:test": "vitest run packages/mobile-bridge/test apps/mobile/src apps/server/src/mobile apps/app/src/lib/native-shell.test.ts apps/app/src/components/MobileShellChrome.test.tsx apps/app/src/components/composer/ThreadComposerToolbar.test.tsx apps/app/src/components/thread/ThreadTimeline.scroll.test.tsx apps/app/src/components/thread/timeline/thread-message-sent.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.11.1",
    "croner": "^10.0.1",
    "electron-updater": "^6.8.9",
    "jiti": "^2.6.1",
    "node-pty": "1.2.0-beta.15",
    "smol-toml": "^1.7.0",
    "ws": "^8.21.3",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "microsandbox": "0.6.10"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^26.2.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "happy-dom": "^20.10.6",
    "js-yaml": "^4.1.0",
    "proper-lockfile": "^4.1.2",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.20.5",
    "turbo": "^2.8.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/salesforce/zana"
  },
  "keywords": [],
  "license": "MIT"
}
