{
  "name": "zana-command-center",
  "productName": "Zana",
  "version": "1.0.9",
  "private": true,
  "description": "Zana Command Center — multi-project terminal hub for Claude Code sessions",
  "author": "grebmann",
  "homepage": "https://github.com/salesforce/zana",
  "main": "out/main/index.js",
  "type": "module",
  "workspaces": [
    "packages/*",
    "website"
  ],
  "scripts": {
    "prepare": "node scripts/ensure-node-pty-helper.mjs && git config core.hooksPath .githooks || true",
    "build:cli": "npm run build --workspace @zcc/cli",
    "fetch:opencode": "node scripts/fetch-opencode-binaries.mjs",
    "predev": "node scripts/ensure-node-pty-helper.mjs && npm run build:cli && node scripts/seed-extensions.mjs",
    "dev": "electron-vite dev",
    "prestart": "node scripts/ensure-node-pty-helper.mjs && npm run build:cli && node scripts/seed-extensions.mjs",
    "start": "electron-vite dev",
    "seed:extensions": "node scripts/seed-extensions.mjs",
    "publish-extension": "node scripts/publish-extension.mjs",
    "prebuild": "node scripts/ensure-node-pty-helper.mjs && npm run build:cli",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:smoke": "npm run build && playwright test e2e/smoke.spec.ts",
    "test:smoke:only": "playwright test e2e/smoke.spec.ts",
    "test:codex:live": "ZCC_LIVE_CODEX=1 vitest run src/main/harness/__tests__/codex-provider.live.test.ts",
    "rebuild": "electron-rebuild -f -w node-pty,better-sqlite3",
    "check:release-notes": "node scripts/check-release-notes.mjs",
    "dist": "npm run check:release-notes && npm run build:cli && npm run fetch:opencode && electron-vite build && electron-builder",
    "dist:mac": "npm run check:release-notes && npm run build:cli && npm run fetch:opencode && electron-vite build && electron-builder --mac",
    "release:mac": "npm run check:release-notes && npm run build:cli && npm run fetch:opencode && GH_TOKEN=$(GH_HOST=github.com gh auth token) electron-vite build && GH_TOKEN=$(GH_HOST=github.com gh auth token) electron-builder --mac --publish always",
    "release:static": "npm run dist:mac && node scripts/upload-release.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.80.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^11.10.0",
    "croner": "^10.0.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-diff-viewer-continued": "^4.3.0",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.7.0",
    "zustand": "^5.0.0"
  },
  "optionalDependencies": {
    "microsandbox": "0.6.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/salesforce/zana"
  },
  "keywords": [],
  "license": "MIT"
}
