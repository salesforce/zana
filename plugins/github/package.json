{
  "name": "@zcc-ext/github",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browse issues and pull requests from a GitHub repository.",
  "engines": {
    "zcc": ">=1.0.0",
    "zccPluginSdk": ">=0.1.0"
  },
  "zcc": {
    "name": "GitHub",
    "description": "Browse issues and pull requests from a GitHub repository.",
    "branding": {
      "icon": "./icons/github.png"
    },
    "server": "./server.mjs",
    "app": "./app.js",
    "extra": {
      "remoteEnvironment": [
        "GH_TOKEN",
        "GIT_CONFIG_*",
        "GIT_AUTHOR_NAME",
        "GIT_AUTHOR_EMAIL",
        "GIT_COMMITTER_NAME",
        "GIT_COMMITTER_EMAIL"
      ]
    }
  }
}
