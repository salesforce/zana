    "monaco-editor": "^0.56.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.0",
    "@zana-ai/zcc-plugin-build": "workspace:*",
