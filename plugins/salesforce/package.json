{
  "name": "@zcc-ext/salesforce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Salesforce project workbench for ZCC: connected orgs, SOQL, Apex, deployments, Agentforce, and reusable native side panels.",
  "engines": {
    "zcc": ">=1.0.0",
    "zccPluginSdk": ">=0.1.0"
  },
  "scripts": {
    "build": "node scripts/build-app.mjs",
    "build:playground": "node scripts/build-playground.mjs",
    "package": "node scripts/build-app.mjs"
  },
  "zcc": {
    "name": "Salesforce",
    "description": "A project-aware Salesforce workbench with data exploration, Apex and logs, deployments, Agentforce, and tools beside your agents. Install with `zcc plugin install salesforce`.",
    "branding": {
      "icon": "Cloud"
    },
    "server": "./server.ts",
    "app": "./app.js",
    "skills": [
      "skills"
    ]
  },
  "exports": {
    "./sdk": "./lib/sdk-contract.ts",
    "./ui": "./ui.ts",
    "./panels": "./panels.tsx"
  },
  "dependencies": {
    "@salesforce/metadata-visualizer-web": "1.7.0",
    "@sf-agentscript/agentforce": "2.10.38",
    "@sf-agentscript/lsp": "2.6.33",
    "@sf-agentscript/monaco": "2.4.39",
    "@sf-agentscript/parser": "4.0.19",
    "@xyflow/react": "^12.10.0",
    "fast-xml-parser": "5.11.1",
    "lucide-react": "^1.47.0",
    "monaco-editor": "^0.54.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.0",
    "@zana-ai/zcc-plugin-build": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vite": "^7.2.2"
  }
}
