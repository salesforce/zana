{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@zana-ai/zcc-plugin-sdk": [
        "../../packages/plugin-sdk/bundled-types/zcc-plugin-sdk.d.ts"
      ],
      "@zana-ai/zcc-plugin-sdk/app": [
        "../../packages/plugin-sdk/bundled-types/zcc-plugin-sdk-app.d.ts"
      ]
    },
    "types": ["node"]
  },
  "include": ["server.ts", "app.tsx", "src", "vitest.config.ts"],
  "exclude": [
    "src/host.ts",
    "src/native-roots.ts",
    "src/native-roots.test.ts",
    "src/server.test.ts",
    "src/bridge/bridge.recorded-conformance.test.ts"
  ]
}
